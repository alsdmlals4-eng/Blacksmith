    "unknown_authority": "FAIL_CLOSED"
  },
  "ci": {
    "design_contract_job": "authority-entry-contract",
    "planned_runtime_job": "gut-runtime-read-only",
    "tracked_authoring_surface_hash_before_after": "REQUIRED",
    "junit_artifact": "REQUIRED_AFTER_RUNTIME_ADOPTION",
    "authority_manifest_validation": "REQUIRED_AFTER_RUNTIME_ADOPTION",
    "current_design_pr_installs_gut": false,
    "current_design_pr_changes_product_paths": false
  },
  "entry_gate": {
    "mode": "FAIL_CLOSED",
    "required_sheet_surfaces": [
