    "non_owned_surfaces": [
      "tests/gut/**",
      ".gutconfig.json",
      "addons/gut/**",
      "CI test result files"
    ]
  },
  "gut": {
    "product": "bitwes/Gut",
    "source_repository": "https://github.com/bitwes/Gut",
    "version": "9.7.1",
    "tag": "v9.7.1",
    "commit": "aeb5d4f3f7f0a6c9b5e178876d6c99b791fda605",
    "release_date": "2026-07-10",
    "license": "MIT",
    "license_path": "addons/gut/LICENSE.md",
    "godot_compatibility": "4.7.x",
    "status": "NOT_INSTALLED_DESIGN_ONLY",
    "target_role": "SOLE_GDSCRIPT_TEST_FRAMEWORK_AUTHORITY",
