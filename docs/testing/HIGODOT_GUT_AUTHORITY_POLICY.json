      "01_작업순서",
      "02_현재_확정결정",
      "04_누락_충돌_감사",
      "72_이미지검수_승인로그"
    ],
    "required_repository_surfaces": [
      "CURRENT_CONFIRMED_DECISIONS.md",
      "docs/planning/CURRENT_R2_CANON_REGISTRY.json",
      "[기획서]/00_프로젝트_허브/DEVELOPMENT_GATES.md",
      "open PR exact-head state"
    ],
    "generic_ready_or_awaiting_is_sufficient": false,
    "stale_or_missing_input": "BLOCK_ENTRY"
  },
  "removal": {
    "mode": "REMOVAL_BY_SEPARATE_REVIEWED_CHANGE",
    "remove_paths": [
      "addons/gut/**",
      ".gutconfig.json",
